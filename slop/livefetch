#!/usr/bin/env python3
"""
livefetch - A live-updating system information display.
Like neofetch meets htop.
"""

import os
import re
import time
import shutil
import platform
import subprocess
from datetime import timedelta

import psutil

_prev_cpu = None  # for tracking CPU across iterations

# ═══════════════════════════════════════════════════════════════
#  USER ASCII ART — Replace the LOGO string below with your own
# ═══════════════════════════════════════════════════════════════
LOGO = r""" 
__     ____  
\ \  _|___ \ 
 \ \(_) __) |
  > >  |__ < 
 / / _ ___) |
/_/ (_)____/       
"""
# ═══════════════════════════════════════════════════════════════
#  END USER ASCII ART
# ═══════════════════════════════════════════════════════════════

RESET = "\033[0m"
BOLD = "\033[1m"
DIM = "\033[2m"
CYAN = "\033[1;36m"
YELLOW = "\033[1;33m"
GREEN = "\033[1;32m"
RED = "\033[1;31m"

ANSI_RE = re.compile(r'\033\[[0-9;]*[mKHf]')


def vis_len(s):
    return len(ANSI_RE.sub('', s))


def pad_to(s, width):
    return s + ' ' * max(0, width - vis_len(s))


def progress_bar(percent, width=20):
    filled = int(width * percent / 100)
    if percent >= 80:
        c = RED
    elif percent >= 60:
        c = YELLOW
    else:
        c = GREEN
    bar = c + '█' * filled + RESET + '░' * (width - filled)
    return f"{bar} {percent:.1f}%"


def colored_pct(p):
    if p >= 80:
        c = RED
    elif p >= 60:
        c = YELLOW
    else:
        c = GREEN
    return f"{c}{p:.0f}%{RESET}"


def label_val(label, val, lc=YELLOW):
    return f"{lc}{label}{RESET}  {val}"


def get_os_info():
    s = platform.system()
    if s == 'Darwin':
        v = platform.mac_ver()[0]
        arch = platform.machine()
        return f"macOS {v} {arch}"
    elif s == 'Linux':
        try:
            with open('/etc/os-release') as f:
                for line in f:
                    if line.startswith('PRETTY_NAME='):
                        return line.split('=', 1)[1].strip().strip('"')
        except OSError:
            pass
    return s


def get_kernel():
    return platform.release()


def get_uptime():
    boot = psutil.boot_time()
    delta = timedelta(seconds=int(time.time() - boot))
    parts = []
    if delta.days:
        parts.append(f"{delta.days}d")
    h, m = divmod(delta.seconds, 3600)
    m //= 60
    if h:
        parts.append(f"{h}h")
    parts.append(f"{m}m")
    return ' '.join(parts)


def get_shell():
    return os.environ.get('SHELL', 'unknown').split('/')[-1]


def get_packages():
    counts = {}
    system = platform.system()
    if system == 'Darwin':
        try:
            r = subprocess.run(['brew', 'list', '--formula', '-1'],
                               capture_output=True, text=True, timeout=10)
            if r.returncode == 0:
                n = len([l for l in r.stdout.splitlines() if l.strip()])
                counts['brew'] = n
        except Exception:
            pass
    elif system == 'Linux':
        for cmd, flag in [('dpkg', '--get-selections'), ('rpm', '-qa'), ('pacman', '-Qq')]:
            try:
                r = subprocess.run([cmd, flag], capture_output=True, text=True, timeout=10)
                if r.returncode == 0:
                    n = len([l for l in r.stdout.splitlines() if l.strip()])
                    counts[cmd] = n
            except Exception:
                pass
    if counts:
        return ', '.join(f"{n} ({name})" for name, n in counts.items())
    return 'none'


def get_resolution():
    s = platform.system()
    try:
        if s == 'Darwin':
            r = subprocess.run(['system_profiler', 'SPDisplaysDataType', '-detailLevel', 'mini'],
                               capture_output=True, text=True, timeout=10)
            for line in r.stdout.splitlines():
                if 'Resolution' in line:
                    return line.split(':', 1)[-1].strip()
        elif s == 'Linux':
            r = subprocess.run(['xrandr'], capture_output=True, text=True, timeout=5)
            for line in r.stdout.splitlines():
                if '*' in line:
                    return line.split()[0]
    except Exception:
        pass
    return 'unknown'


def get_cpu_name():
    s = platform.system()
    try:
        if s == 'Darwin':
            r = subprocess.run(['sysctl', '-n', 'machdep.cpu.brand_string'],
                               capture_output=True, text=True, timeout=3)
            if r.returncode == 0:
                return r.stdout.strip()
        elif s == 'Linux':
            with open('/proc/cpuinfo') as f:
                for line in f:
                    if line.startswith('model name'):
                        return line.split(':', 1)[1].strip()
    except Exception:
        pass
    return platform.processor() or 'unknown'


def get_hostname():
    return platform.node()


def get_gpu():
    s = platform.system()
    try:
        if s == 'Darwin':
            r = subprocess.run(['system_profiler', 'SPDisplaysDataType', '-detailLevel', 'mini'],
                               capture_output=True, text=True, timeout=10)
            for line in r.stdout.splitlines():
                ls = line.strip()
                if 'Chipset Model' in ls:
                    return ls.split(':', 1)[-1].strip()
    except Exception:
        pass
    return 'unknown'


def get_memory():
    m = psutil.virtual_memory()
    return m.used / 1024**3, m.total / 1024**3, m.percent


def get_disk():
    d = psutil.disk_usage('/')
    return d.used / 1024**3, d.total / 1024**3, d.percent


def get_stats():
    global _prev_cpu
    if _prev_cpu is None:
        # first call: prime the measurement so next call is meaningful
        psutil.cpu_percent(interval=0.1)
        _prev_cpu = True
    cpu = psutil.cpu_percent(interval=None)
    cores = psutil.cpu_percent(interval=None, percpu=True)
    procs = len(psutil.pids())
    l1, l5, l15 = psutil.getloadavg()
    return cpu, cores, procs, l1, l5, l15


def build_info():
    host = get_hostname()
    os_i = get_os_info()
    kernel = get_kernel()
    uptime = get_uptime()
    shell = get_shell()
    pkgs = get_packages()
    res = get_resolution()
    cpu = get_cpu_name()
    gpu = get_gpu()
    used_mem, total_mem, mem_pct = get_memory()
    used_disk, total_disk, disk_pct = get_disk()
    cpu_pct, cpu_cores, procs, l1, l5, l15 = get_stats()

    sep = DIM + '─' * 28 + RESET

    lines = [
        f"{CYAN}{host}{RESET}",
        '',
        label_val('OS:', os_i),
        label_val('Kernel:', kernel),
        label_val('Uptime:', uptime),
        label_val('Packages:', pkgs),
        label_val('Shell:', shell),
        label_val('Resolution:', res),
        label_val('CPU:', cpu),
        label_val('GPU:', gpu),
        label_val('Memory:', f"{used_mem:.1f}GiB / {total_mem:.1f}GiB"),
        label_val('Disk:', f"{used_disk:.1f}GiB / {total_disk:.1f}GiB"),
        '',
        sep,
        '',
        label_val('CPU:', f"{colored_pct(cpu_pct)}  [{', '.join(colored_pct(c) for c in cpu_cores)}]", GREEN),
        label_val('Processes:', str(procs), GREEN),
        label_val('Load Avg:', f"{l1:.2f}  {l5:.2f}  {l15:.2f}", GREEN),
        '',
        f"  RAM  {progress_bar(mem_pct)}",
        f"  DISK {progress_bar(disk_pct)}",
    ]
    return lines


def parse_logo(raw):
    lines = raw.strip('\n').split('\n')
    stripped = [ln for ln in lines if ln.strip()]
    if stripped:
        min_indent = min(len(ln) - len(ln.lstrip()) for ln in stripped)
        lines = [ln[min_indent:] if ln.strip() else ln for ln in lines]
    return lines


def merge_sbs(left, right, pad=4):
    term_w = shutil.get_terminal_size().columns
    lw = max((vis_len(l) for l in left), default=0)
    if lw + pad + 10 > term_w:
        lw = term_w // 3
    out = []
    n = max(len(left), len(right))
    for i in range(n):
        l = left[i] if i < len(left) else ''
        r = right[i] if i < len(right) else ''
        out.append(pad_to(l, lw + pad) + r)
    return out


def main():
    try:
        logo = parse_logo(LOGO)
        print('\033[?25l', end='', flush=True)
        while True:
            right = build_info()
            merged = merge_sbs(logo, right)
            print('\033[H' + '\n'.join(merged), end='', flush=True)
            time.sleep(1)
    except KeyboardInterrupt:
        pass
    finally:
        print(RESET + '\033[?25h')


if __name__ == '__main__':
    main()
