# Soft Nature Green Theme
# Colors
VIBRANT_GREEN=0xff39ff14
FOCUSED_WHITE=0xffffffff
WHITE=0xffffffff

sketchybar --add event aerospace_workspace_change

for sid in $(aerospace list-workspaces --all); do
    sketchybar --add item space.$sid left \
        --subscribe space.$sid aerospace_workspace_change \
        --set space.$sid \
        background.drawing=off \
        background.corner_radius=6 \
        background.height=22 \
        padding_left=10 \
        padding_right=10 \
        drawing=off \
        label="$sid" \
        label.color=$VIBRANT_GREEN \
        label.highlight_color=0xffffffff \
        click_script="aerospace workspace $sid" \
        script="$CONFIG_DIR/plugins/aerospace.sh $sid" \
        update_freq=5
done

PLUGIN_DIR="$CONFIG_DIR/plugins"

##### Bar Appearance #####
sketchybar --bar position=top height=38 blur_radius=0 color=0x00000000

##### Changing Defaults #####
default=(
  padding_left=5
  padding_right=5
  icon.font="Hack Nerd Font:Bold:17.0"
  label.font="Hack Nerd Font:Bold:14.0"
  icon.color=$VIBRANT_GREEN
  label.color=$VIBRANT_GREEN
  icon.padding_left=4
  icon.padding_right=4
  label.padding_left=4
  label.padding_right=4
)
sketchybar --default "${default[@]}"

##### Adding Left Items #####
sketchybar --add item chevron left \
           --set chevron icon= label.drawing=off icon.color=$VIBRANT_GREEN \
           --add item front_app left \
           --set front_app icon.drawing=off script="$PLUGIN_DIR/front_app.sh" \
           --subscribe front_app front_app_switched

##### Adding Right Items #####
sketchybar --add item clock right \
           --set clock update_freq=10 icon= script="$PLUGIN_DIR/clock.sh" \
           --add item volume right \
           --set volume script="$PLUGIN_DIR/volume.sh" \
           --subscribe volume volume_change \
           --add item battery right \
           --set battery update_freq=120 script="$PLUGIN_DIR/battery.sh" \
           --subscribe battery system_woke power_source_change \
           --add item cpu right \
           --set cpu update_freq=5 icon= script="$PLUGIN_DIR/cpu.sh" \
           --add item ram right \
           --set ram update_freq=5 icon= script="$PLUGIN_DIR/ram.sh"

sketchybar --update
