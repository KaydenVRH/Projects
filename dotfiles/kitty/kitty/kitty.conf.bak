background_opacity 0.6
background_blur 50
cursor_trail 3
font_size 20

# Tell programs they're in Kitty (fixes curses/TUI Unicode rendering)
term xterm-kitty

# Fix TUI apps in Kitty windows
allow_remote_control yes
sync_to_monitor no

# Render Unicode block/box chars natively (fixes progress bars, etc.)
box_drawing_marks yes
symbol_map U+2500-U+25FF U+2580-U+259F Hack Nerd Font Mono

# Active pane borders (increase visibility)
active_border_color #ffcc66
inactive_border_color #444444
border_width 3.0
#remove title bar/window decorations 

hide_window_decorations titlebar-and-corners
# # ============================================================
# # TMUX-LIKE BINDINGS  (prefix: Ctrl+B)
# # Usage: press Ctrl+B, release, then press the command key
# # ============================================================
# 
# # Splits (like tmux " and %)
# map ctrl+b>\"          launch --location=hsplit
# map ctrl+b>%           launch --location=vsplit
# 
# # Pane navigation (like tmux arrow keys)
# map ctrl+b>left        neighboring_window left
# map ctrl+b>right       neighboring_window right
# map ctrl+b>up          neighboring_window up
# map ctrl+b>down        neighboring_window down
# 
# # Tab management (like tmux c, n, p, 0-9)
# map ctrl+b>c           new_tab
# map ctrl+b>n           next_tab
# map ctrl+b>p           previous_tab
# map ctrl+b>&           close_tab
# map ctrl+b>1           goto_tab 1
# map ctrl+b>2           goto_tab 2
# map ctrl+b>3           goto_tab 3
# map ctrl+b>4           goto_tab 4
# map ctrl+b>5           goto_tab 5
# map ctrl+b>6           goto_tab 6
# map ctrl+b>7           goto_tab 7
# map ctrl+b>8           goto_tab 8
# map ctrl+b>9           goto_tab 9
# 
# # Layout cycling & fullscreen (like tmux spacebar, z)
# map ctrl+b>space       next_layout
# map ctrl+b>z           toggle_fullscreen
# 
# # Resize panes (like tmux Ctrl+arrows)
# map ctrl+b>ctrl+left   resize_window narrower
# map ctrl+b>ctrl+right  resize_window wider
# map ctrl+b>ctrl+up     resize_window taller
# map ctrl+b>ctrl+down   resize_window shorter
# 
# # Misc
# map ctrl+b>[           show_scrollback
# map ctrl+b>r           load_config_file
# map ctrl+b>w           launch --location=neighbor
# map ctrl+b>m  launch --type=os-window yt-music-tui

# ============================================================
# THEME
# ============================================================
# BEGIN_KITTY_THEME
# Base2Tone Field Dark
include current-theme.conf
# END_KITTY_THEME

# Tab bar overrides — green to match theme
active_tab_foreground   #18201e
active_tab_background   #00943e
inactive_tab_foreground #8ea4a0
inactive_tab_background #1a3325
tab_bar_background      #0d2618
tab_bar_edge            bottom
